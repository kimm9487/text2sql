# ============================================================================
# Text2SQL 백엔드 설정 — 이 파일을 .env 로 복사해서 사용 (.env 는 git 에 올리지 않음)
# ============================================================================

# 조회 대상 DB(과제용 샘플) / 앱 DB(계정·조회 로그) — backend 기준 상대경로
DB_PATH=data/content_platform.db
APP_DB_PATH=data/app.db

# JWT 서명 키 (32자 이상 임의 문자열로 교체)
JWT_SECRET_KEY=change-this-to-a-long-random-string-32chars
JWT_EXPIRE_MINUTES=120

# LLM — none: 템플릿 질문만 처리 / claude: 템플릿에 없는 질문을 Claude 가 SQL 로 변환
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
ANTHROPIC_API_KEY=

# 실행 제한
QUERY_TIMEOUT_SEC=5
MAX_RESULT_ROWS=1000
